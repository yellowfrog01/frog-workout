# deploy.sh / remote-bridge.sh 가 읽는 기기·네트워크 식별값.
# 이 파일을 deploy.env 로 복사해서 본인 값으로 채운다. (deploy.env 는 gitignore 됨)

# 아이폰 UDID — 'xcrun devicectl list devices' 의 Identifier 열 (deploy.sh 가 사용)
PHONE_UDID="00000000-0000000000000000"
# 아이폰 CoreDevice ID — 'xcrun devicectl list devices' 의 Identifier (UUID 형식, remote-bridge.sh 가 사용)
PHONE_COREDEVICE_ID="00000000-0000-0000-0000-000000000000"
# 애플워치 ID — devicectl 에 뜨는 워치 Identifier (deploy.sh watch 가 사용)
WATCH_ID="00000000-0000-0000-0000-000000000000"
# 아이폰 Bonjour 호스트명 — 예: my-iPhone.local
PHONE_HOST="my-iPhone.local"
# 아이폰의 Tailscale(tailnet) IP — 'tailscale status' 에서 확인
PHONE_TAILNET_IP="100.64.0.1"
